    public void playGame() {
        for (int round = 1; round <= 3; round++) {
            System.out.println("Round " + round);
            initializeDecks();
            playRound();
        }

        determineWinner();
    }

    private void initializeDecks() {
        int[][] gameDeck = createGameDeck();
        int[][] playerDecks = new int[2][PLAYER_CARDS + ADDITIONAL_CARDS];

        // Distribute cards from the game deck to player decks
        for (int i = 0; i < PLAYER_CARDS; i++) {
            playerDecks[0][i] = gameDeck[i][0]; // Computer's deck
            playerDecks[1][i] = gameDeck[gameDeck.length - 1 - i][0]; // User's deck
        }

        // Generate additional random cards for player decks
        for (int i = PLAYER_CARDS; i < PLAYER_CARDS + ADDITIONAL_CARDS; i++) {
            if (i < PLAYER_CARDS + 3) {
                // Three cards with random colors and values between 1 to 6
                playerDecks[0][i] = generateRandomCard();
                playerDecks[1][i] = generateRandomCard();
            } else {
                // The remaining two cards with an 80 percent chance of being a signed card
                if (Math.random() < 0.8) {
                    // Normal signed card
                    playerDecks[0][i] = generateRandomSignedCard();
                    playerDecks[1][i] = generateRandomSignedCard();
                } else {
                    // Lucky case: one flip card and one double card
                    playerDecks[0][i] = generateFlipCard();
                    playerDecks[1][i] = generateDoubleCard();
                }
            }
        }

        // Shuffle the player decks
        private void shuffleDeck(int[][] deck) {
            Random random = new Random();
            for (int i = deck.length - 1; i > 0; i--) {
                int index = random.nextInt(i + 1);

                // Swap the cards at positions i and index
                int[] temp = deck[i];
                deck[i] = deck[index];
                deck[index] = temp;
            }
        }

        shuffleDeck(playerDecks[0]);
        shuffleDeck(playerDecks[1]);
    }

    private void playRound() {
        int[] computerHand = chooseRandomHand();
        int[] userHand = chooseRandomHand();

        int computerTurn = playTurn(computerHand, "Computer");
        int userTurn = playTurn(userHand, "User");

        determineRoundWinner(computerTurn, userTurn);
    }

    private int[] chooseRandomHand() {
        int[] hand = new int[4];
        Random random = new Random();

        for (int i = 0; i < 4; i++) {
            hand[i] = random.nextInt(PLAYER_CARDS + ADDITIONAL_CARDS);
        }

        return hand;
    }

    private int playTurn(int[] hand, String playerName) {
        int totalScore = 0;
        int lastPlayedCard = 0;

        for (int cardIndex : hand) {
            int cardValue = getCardValue(cardIndex);
            totalScore += cardValue;

            if (cardValue > 0) {
                System.out.println(playerName + " plays a " + cardValue + " card.");
                lastPlayedCard = cardValue;
            } else if (cardValue < 0) {
                System.out.println(playerName + " plays a " + cardValue + " card.");
                lastPlayedCard = cardValue;
            } else if (cardValue == 0) {
                System.out.println(playerName + " plays a " + getSpecialCardType(cardIndex) + " card.");
                lastPlayedCard = applySpecialCardEffect(lastPlayedCard, cardIndex);
            }
        }

        System.out.println(playerName + "'s total score: " + totalScore);
        return totalScore;
    }

    private void determineRoundWinner(int computerTurn, int userTurn) {
        if (computerTurn > 20 && userTurn > 20) {
            System.out.println("Both players busted. It's a tie!");
        } else if (computerTurn > 20) {
            System.out.println("Computer busted! User wins the round.");
            userScore++;
        } else if (userTurn > 20) {
            System.out.println("User busted! Computer wins the round.");
            computerScore++;
        } else if (computerTurn > userTurn) {
            System.out.println("Computer wins the round!");
            computerScore++;
        } else if (userTurn > computerTurn) {
            System.out.println("User wins the round!");
            userScore++;
        } else {
            System.out.println("It's a tie!");
        }
    }

    private void determineWinner() {
        if (userScore > computerScore) {
            System.out.println("User wins the game!");
        } else if (computerScore > userScore) {
            System.out.println("Computer wins the game!");
        } else {
            System.out.println("The game is tied!");
        }
    }

    private int[][] createGameDeck() {
        int[][] deck = new int[TOTAL_SETS * CARDS_PER_SET][2];
        String[] colors = {"Blue", "Yellow", "Red", "Green"};

        int index = 0;
        for (String color : colors) {
            for (int value = 1; value <= CARDS_PER_SET; value++) {
                deck[index][0] = generateCardValue(color, value);
                index++;
            }
        }

        shuffleDeck(deck);
        return deck;
    }

    private int generateCardValue(String color, int value) {
        if ("Blue".equals(color)) {
            return value;
        } else if ("Yellow".equals(color)) {
            return -value;
        } else if ("Red".equals(color)) {
            return value;
        } else if ("Green".equals(color)) {
            return -value;
        }
        return 0;
    }

    private int generateRandomCard() {
        Random random = new Random();
        return random.nextInt(6) + 1;
    }

    private int generateRandomSignedCard() {
        Random random = new Random();
        int value = random.nextInt(6) + 1;
        return (random.nextBoolean()) ? value : -value;
    }

