		    private String arrayToString(int[] array) {
		        StringBuilder result = new StringBuilder("[");
		        for (int i = 0; i < array.length; i++) {
		            result.append(array[i]);
		            if (i < array.length - 1) {
		                result.append(", ");
		            }
		        }
		        result.append("]");
		        return result.toString();
		    }

		    private int getSum(int[] board) {
		        int sum = 0;
		        for (int value : board) {
		            sum += value;
		        }
		        return sum;
		    }

		    private Card[] createGameDeck() {
		        Card[] deck = new Card[40];
		        String[] colors = {"Blue", "Yellow", "Red", "Green"};

		        int index = 0;
		        for (String color : colors) {
		            for (int value = 1; value <= 10; value++) {
		                deck[index++] = new Card(color, value);
		            }
		        }

		        return deck;
		    }

		    private Card generateRandomCard() {
		        Random random = new Random();
		        String color = getRandomColor();
		        int value = random.nextInt(6) + 1;
		        boolean isPositive = random.nextBoolean();

		        if (!isPositive) {
		            value = -value;
		        }

		        return new Card(color, value);
		    }

		    private String getRandomColor() {
		        String[] colors = {"Blue", "Yellow", "Red", "Green"};
		        Random random = new Random();
		        return colors[random.nextInt(colors.length)];
		    }

		    private void shuffleDeck(Card[] deck) {
		        Random random = new Random();
		        for (int i = deck.length - 1; i > 0; i--) {
		            int index = random.nextInt(i + 1);
		            Card temp = deck[i];
		            deck[i] = deck[index];
		            deck[index] = temp;
		        }
		    }

		    private Card[] removeCardFromDeck(int index) {
		        Card[] newDeck = new Card[gameDeck.length - 1];
		        System.arraycopy(gameDeck, 0, newDeck, 0, index);
		        System.arraycopy(gameDeck, index + 1, newDeck, index, gameDeck.length - index - 1);
		        return newDeck;
		    }

		    private class Card {
		        private String color;
		        private int value;

		        public Card(String color, int value) {
		            this.color = color;
		            this.value = value;
		        }

		        public int getValue() {
		            return value;
		        }
